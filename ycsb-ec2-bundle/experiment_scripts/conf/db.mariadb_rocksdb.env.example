# MariaDB (RocksDB / MyRocks) endpoint and role. Copy to conf/db.mariadb_rocksdb.env - that
# file is gitignored, so credentials never enter the repository:
#   cp conf/db.mariadb_rocksdb.env.example conf/db.mariadb_rocksdb.env
# Loaded automatically by ./experiment.sh mariadb_rocksdb; variables you export always win.
#
# The server must actually have the RocksDB engine - `SHOW ENGINES` has to list ROCKSDB as
# DEFAULT or YES. Neither docker.io/library/mariadb nor MariaDB's own images ship it: MyRocks
# has to be compiled in, so this backend runs against a purpose-built image (see the local
# note below) or an EC2 host built with -DPLUGIN_ROCKSDB=YES.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=ycsb
DB_PWD=change-me

# Database names: the run drops and recreates all three on every start.
DB_NAME=ycsb
UNCHANGED_DB_NAME=ycsb_unchange
BACKUP_DB_NAME=ycsb_backup

# Admin CLIs. This engine only exists in MariaDB builds that still use the mysql / mysqldump
# spellings (the 10.3-era ones); MariaDB 11 images renamed them to mariadb / mariadb-dump.
MARIADB_CLI=mysql
MARIADB_DUMP_CLI=mysqldump

# Set only when the server is not a local process, e.g. a container on the benchmark host.
# The wrapped client then talks to the server through the container's own socket (so
# DB_HOST/DB_PORT are not passed to it) and must be handed the password explicitly:
#   MARIADB_CLI_WRAP=podman exec -i -e MYSQL_PWD ycsb_mariadb_rocksdb
# With a wrap there is no local server process to sample, so the CPU/Memory columns report 0.

# JDBC URL scheme: MariaDB Connector/J 3.x only accepts jdbc:mariadb, the 2.x driver used by
# the old EC2 runners expects jdbc:mysql (the legacy rocksdb script hardcoded jdbc:mysql).
#MARIADB_JDBC_SCHEME=jdbc:mariadb

# OS account of the server process, sampled for the CPU/Memory columns.
#HOST_OS_USER=mysql

# Statistics come from SHOW GLOBAL STATUS 'Rocksdb%', information_schema.ROCKSDB_CFSTATS /
# ROCKSDB_DBSTATS / ROCKSDB_SST_PROPS and need no configuration. Two columns are fixed at 0 on
# servers that do not report the fact: lsm_levels (MariaDB >= 10.6 adds LEVEL to SST_PROPS) -
# see lib/backends/mariadb_rocksdb.sh.
