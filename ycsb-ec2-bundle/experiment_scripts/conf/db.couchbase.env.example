# Couchbase endpoint. Copy to conf/db.couchbase.env - that file is gitignored, so credentials
# never enter the repository:
#   cp conf/db.couchbase.env.example conf/db.couchbase.env
# Loaded automatically by ./experiment.sh couchbase; variables you export always win.
#
# Unquoted values keep a trailing "#..." verbatim (the file is parsed, not executed) - write a
# comment on its own line.

COUCHBASE_HOST=127.0.0.1
COUCHBASE_PORT_MGMT=8091     # management/REST API (buckets, flush, index status)
COUCHBASE_PORT_QUERY=8093    # N1QL query service - required by this backend
COUCHBASE_PORT_KV=11210      # data service; only used to decide couchbase.kv

# --- two credentials, because SDK 2.x authenticates as the bucket ------------------------------
#
# COUCHBASE_USERNAME / COUCHBASE_PASSWORD: the harness's management user. It lists and flushes
# buckets, reads /indexStatus and runs the N1QL that copies main -> comparison (that statement
# spans two buckets, so a bucket-scoped user cannot run it).
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=

# DB_PWD: the password the YCSB binding uses. SDK 2.x has no username property -
# cluster.openBucket(bucket, password) sends the *bucket name* as the username - so each bucket
# needs a local user named exactly like it (ycsb, ycsb_unchange, ycsb_backup). The runner probes
# that credential in preflight and creates the users when it creates the buckets.
DB_PWD=

# --- experiment roles --------------------------------------------------------------------------
# The three roles are three buckets of one cluster (unlike neo4j, where they are three servers).
DB_NAME=ycsb
UNCHANGED_DB_NAME=ycsb_unchange
BACKUP_DB_NAME=ycsb_backup

# 1 = create a missing bucket (flush enabled) and its bucket-named user; needs cluster-management
# rights. 0 = all three buckets and users are provisioned beforehand, which is what the EC2 hosts
# did; preflight then fails with a clear message instead of provisioning anything.
COUCHBASE_CREATE_MISSING_BUCKETS=1
COUCHBASE_BUCKET_RAM_QUOTA_MB=256

# --- binding behaviour (defaults are the values the legacy runners used) ------------------------
#COUCHBASE_ADHOC=true          # no prepared statements
#COUCHBASE_KV_MODE=false       # true | false | auto - false also runs mutations through N1QL
#COUCHBASE_BOOST=1             # number of SDK event loops
#INSERTION_RETRY_LIMIT=20
#INSERTION_RETRY_INTERVAL=2

# --- waits --------------------------------------------------------------------------------------
# Couchbase's global secondary indexes are asynchronous: a query is only meaningful once the
# bucket's primary index is Ready, and counts can lag behind writes.
#INDEX_READY_TIMEOUT_SEC=180
#INDEX_READY_POLL_INTERVAL_SEC=2
#CONSISTENCY_TIMEOUT_SEC=120   # how long a copy/flush may take to become visible
#COUCHBASE_DELETE_BATCH_SIZE=500

# OS account of the couchbase-server process, sampled for the CPU/Memory columns. Leave it empty
# when the server is not a local process (a container or another host) - then those two columns
# report 0 rather than some other account's usage.
HOST_OS_USER=
