# MongoDB endpoint. Copy to conf/db.mongodb.env - that file is gitignored, so credentials
# never enter the repository:
#   cp conf/db.mongodb.env.example conf/db.mongodb.env
# Loaded automatically by ./experiment.sh mongodb; variables you export always win.

DB_HOST=127.0.0.1
DB_PORT=27017

# Database names: each phase drops and recreates the one it needs (a MongoDB database exists
# only once it holds data). The comparison database lives on the SAME server - unlike the old
# runner, which needed a second mongod on 27018.
DB_NAME=ycsb
UNCHANGED_DB_NAME=ycsb_unchange
BACKUP_DB_NAME=ycsb_backup

# Admin CLIs (mongosh, mongodump, mongorestore).
MONGO_CLI=mongosh
MONGO_DUMP_CLI=mongodump
MONGO_RESTORE_CLI=mongorestore

# Set only when the server is not reachable with local tools, e.g. it runs in a container on
# the benchmark host. The wrapped tools then talk to the server through the container's own
# network namespace, so DB_HOST/DB_PORT are used only by YCSB itself (publish the port!).
#   MONGO_CLI_WRAP=podman exec -i ycsb_mongo
# With a wrap there is no local mongod process to sample, so CPU/Memory report 0.

# Extra connection-string parameters appended to every URI, e.g. write concern or auth:
#MONGO_URL_PARAMS=?w=1
# This deployment runs without authentication; the binding has no user/password properties
# (they would be part of MONGO_URL_PARAMS).

# OS account of the mongod process, sampled for the CPU/Memory columns.
#HOST_OS_USER=mongod
