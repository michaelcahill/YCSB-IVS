# Heavy scale: the dataset used by the published long-running experiments.
# Apply explicitly:  ./experiment.sh <backend> --config conf/scale.heavy.env
#
# Only used when you want the runner to override the workload template; a template such
# as workloads/workloadc-uniform-heavy already carries these numbers, so applying this
# file to it changes nothing.
RECORDCOUNT=10000
OPERATIONCOUNT=100000
EXTEND_OPERATIONCOUNT=100000
