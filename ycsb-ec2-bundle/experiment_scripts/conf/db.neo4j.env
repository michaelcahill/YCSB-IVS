# Neo4j endpoints and role. Loaded automatically by ./experiment.sh neo4j; exported variables
# always win over this file.
#
# Neo4j Community has ONE user database per instance, so this study's three roles are three
# instances on three Bolt ports (the EC2 hosts ran them as /opt/neo4j-instance-main,
# -backup and -unchange). All three must answer ./experiment.sh neo4j --check.

DB_HOST=127.0.0.1
DB_USERNAME=neo4j
DB_PWD=change-me

# Bolt port of each role. DB_PORT is the main one (the others are named explicitly).
NEO4J_PORT_MAIN=7687
NEO4J_PORT_BACKUP=7787
NEO4J_PORT_UNCHANGE=7887
#DB_PORT=7687

# Or point a role at another host entirely - these win over DB_HOST + the port above:
#NEO4J_BOLT_URI_MAIN=bolt://127.0.0.1:7687
#NEO4J_BOLT_URI_BACKUP=bolt://10.0.0.2:7687
#NEO4J_BOLT_URI_UNCHANGE=bolt://10.0.0.3:7687

# Role names identify the instance in logs and artefact names; they are not database names on
# the server (there is only one database per instance).
DB_NAME=ycsb
UNCHANGED_DB_NAME=ycsb_unchange
BACKUP_DB_NAME=ycsb_backup

# Admin CLI. cypher-shell is required; when the instances run in containers it usually only
# exists inside them, so give the container command here. The wrap picks the instance, so the
# address used inside the container is NEO4J_CLI_BOLT_URI (the instance's own Bolt port).
NEO4J_CLI=cypher-shell
#NEO4J_CLI_WRAP_MAIN=podman exec -i ycsb_neo4j_main
#NEO4J_CLI_WRAP_BACKUP=podman exec -i ycsb_neo4j_backup
#NEO4J_CLI_WRAP_UNCHANGE=podman exec -i ycsb_neo4j_unchange
#NEO4J_CLI_BOLT_URI=bolt://localhost:7687

# The clean-run phase copies main -> comparison with APOC (graphml export/import). The path is
# relative to the *instance's* import directory, so the instances must share it - one volume
# mounted at /var/lib/neo4j/import in each container, or one directory both service accounts can
# write. The directory (and its 'tmp' subdirectory here) must exist and be writable by the server
# account before the first run. A local three-container set:
#   podman volume create ycsb_neo4j_import
#   for spec in main:7687 backup:7787 unchange:7887; do
#     podman run -d --name ycsb_neo4j_${spec%%:*} -p ${spec##*:}:7687 \
#       -e NEO4J_AUTH=neo4j/… -e 'NEO4J_PLUGINS=["apoc"]' \
#       -e NEO4J_apoc_export_file_enabled=true -e NEO4J_apoc_import_file_enabled=true \
#       -e 'NEO4J_dbms_security_procedures_unrestricted=apoc.*' \
#       -e NEO4J_server_memory_heap_max__size=512M -e NEO4J_server_memory_pagecache_size=128M \
#       --memory=1400m -v ycsb_neo4j_import:/var/lib/neo4j/import docker.io/library/neo4j:5
#   done
#   podman exec ycsb_neo4j_main sh -c 'mkdir -p -m 777 /var/lib/neo4j/import/tmp'
NEO4J_APOC_BACKUP_FILE=tmp/ycsb_neo4j_backup.graphml
# Where the instances cannot share a directory (the EC2 hosts had one per instance under
# /opt/neo4j-instance-*/import), name the two absolute paths as the runner sees them and give a
# command template; {src} and {dst} are replaced with them:
#NEO4J_APOC_EXPORT_PATH=/opt/neo4j-instance-main/import/ycsb_neo4j_backup.graphml
#NEO4J_APOC_IMPORT_PATH=/opt/neo4j-instance-backup/import/ycsb_neo4j_backup.graphml
#NEO4J_BACKUP_COPY_CMD='sudo cp {src} {dst} && sudo chown neo4j:neo4j {dst}'

# The neo4j binding needs no extra driver beyond the ones `mvn -Psource-run` puts in
# <YCSB_HOME>/neo4j/target/dependency/.

# OS account of the Neo4j process, sampled for the CPU/Memory columns. With a wrapped CLI there
# is no local process to sample and both columns report 0.
#HOST_OS_USER=neo4j
