# MariaDB (InnoDB) endpoint and role. Copy to conf/db.mariadb_innodb.env - that file is
# gitignored, so credentials never enter the repository:
#   cp conf/db.mariadb_innodb.env.example conf/db.mariadb_innodb.env
# Loaded automatically by ./experiment.sh mariadb_innodb; variables you export always win.
#
# The benchmark role needs CREATE/DROP on the benchmark databases, and the MariaDB JDBC
# driver must be in <YCSB_HOME>/jdbc/target/dependency/ (it is not part of the YCSB build):
#   https://mariadb.com/kb/en/about-mariadb-connector-j/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=ycsb
DB_PWD=change-me

# Database names: the run drops and recreates all three on every start.
DB_NAME=ycsb
UNCHANGED_DB_NAME=ycsb_unchange
BACKUP_DB_NAME=ycsb_backup

# Admin CLIs. On a typical host these are mysql / mysqldump; MariaDB 11 images ship the
# mariadb / mariadb-dump spellings instead, which is why they are configurable.
MARIADB_CLI=mysql
MARIADB_DUMP_CLI=mysqldump

# Set only when the server is not a local process, e.g. a container on the benchmark host.
# The wrapped client then talks to the server through the container's own socket (so
# DB_HOST/DB_PORT are not passed to it) and must be handed the password explicitly:
#   MARIADB_CLI_WRAP=podman exec -i -e MYSQL_PWD ycsb_mariadb
#   MARIADB_CLI=mariadb
#   MARIADB_DUMP_CLI=mariadb-dump
# With a wrap there is no local server process to sample, so the CPU/Memory columns report 0.

# JDBC URL scheme: MariaDB Connector/J 3.x only accepts jdbc:mariadb, the 2.x driver used by
# the old EC2 runners expects jdbc:mysql.
#MARIADB_JDBC_SCHEME=jdbc:mariadb

# OS account of the server process, sampled for the CPU/Memory columns.
#HOST_OS_USER=mysql

# B-tree height (btree_height column) comes from the inno_space tool plus the server's
# tablespace file; both are root-owned, so the column reports 0 unless they are configured:
#INNO_SPACE_TOOL=/opt/inno_space/inno
#INNODB_IBD_FILE=/var/lib/mysql/ycsb/usertable.ibd
