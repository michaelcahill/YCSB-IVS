# PostgreSQL family endpoint and role — loaded automatically for postgresql_row,
# postgresql_textarray, postgresql_json and postgrenosql (before any db.<backend>.env,
# which wins on a clash). Exported variables always win over this file.
#
# Unquoted values keep a trailing "#..." verbatim (the file is parsed, not executed) —
# write comments on their own line.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=ycsb
DB_PWD=USyd2026
PG_MAINTENANCE_DB=postgres

# Databases the run drops and recreates on every start; the maintenance DB is only ever
# read through (statistics, log archiving).
DB_NAME=ycsb
UNCHANGED_DB_NAME=ycsb_unchange
BACKUP_DB_NAME=ycsb_backup

# --- --init: the administrator connection -------------------------------------------------------
# `./experiment.sh <backend> --init` GRANTs and ALTER SYSTEMs so a run can archive the
# server's own evidence; that must never be the benchmark role, which keeps LOGIN + CREATEDB
# only. Most installs admit the superuser only through the OS account (peer/trust on the unix
# socket, often nothing else), so by default the admin psql is wrapped: become that OS user,
# connect over its socket — no host/port, no password. The run itself is unaffected and still
# connects as DB_USERNAME over TCP above.
PG_INIT_ADMIN_CLI_WRAP=sudo -u postgres
PG_INIT_ADMIN_USERNAME=postgres
# Without a wrap the admin connection goes to PG_INIT_ADMIN_HOST/PORT (defaulting to
# DB_HOST/DB_PORT; set PG_INIT_ADMIN_HOST= empty for a local socket on this host) with:
#PG_INIT_ADMIN_PWD=
#PG_INIT_ADMIN_HOST=
#PG_INIT_ADMIN_PORT=
# The role being prepared defaults to DB_USERNAME; name another one here if the benchmark
# role is not the one that will read the server log:
#PG_INIT_TARGET_ROLE=
